BACKEND_LISTEN_ADDR=0.0.0.0
BACKEND_LISTEN_PORT=8000
RELOAD=false

DEFAULT_LLM=qwen3.7-max
DASHSCOPE_API_KEY=

RAG_TOP_K=4
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_EMBED_MODEL=qwen3.7-text-embedding
RAG_EMBED_DIM=1536
RAG_MAX_UPLOAD_FILES=10
RAG_MAX_UPLOAD_FILE_BYTES=10485760
RAG_MAX_UPLOAD_TOTAL_BYTES=26214400
RAG_WEB_FETCH_TIMEOUT_SECONDS=10
RAG_WEB_MAX_CONTENT_CHARS=200000
RAG_DB_MAX_ROWS=1000
RAG_DB_MAX_CHARS_PER_ROW=20000

# memory 仅用于测试；生产用 cloud 并配置下方 URL / API Key
QDRANT_MODE=cloud
QDRANT_URL=https://xxxx.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chatter

# 喂给 LLM 的短期记忆条数上限；完整展示历史不截断
MAX_HISTORY_MESSAGES=10

LOG_LEVEL=INFO
LOG_PATH=./logs
