BACKEND_LISTEN_ADDR=0.0.0.0
BACKEND_LISTEN_PORT=8000
RELOAD=false

DEFAULT_LLM=qwen3.7-max
DASHSCOPE_API_KEY=

RAG_TOP_K=4
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_EMBED_MODEL=qwen3.7-text-embedding
RAG_EMBED_DIM=1536

QDRANT_URL=https://xxxx.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chatter

# 喂给 LLM 的短期记忆条数上限；完整展示历史不截断
MAX_HISTORY_MESSAGES=10

LOG_LEVEL=INFO
LOG_PATH=./logs
